@{
    ViewData["Title"] = "Privacy Policy";
}



<!-- Main Content -->
<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-lg p-4 rounded-4">

                <div class="mb-4 text-center">
                    <p class="fs-5 text-muted">
                        At <strong>Books On Door</strong>, your privacy matters.
                        We’re dedicated to safeguarding your personal information
                        and ensuring transparency in how your data is handled.
                    </p>
                </div>

                <!-- Section 1 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    1. Information We Collect
                </h4>
                <p>We may collect the following information:</p>
                <ul class="list-group mb-3">
                    <li class="list-group-item border-0">
                        <strong>Personal Information:</strong> Name, email, phone, and address.
                    </li>
                    <li class="list-group-item border-0">
                        <strong>Account Details:</strong> Login credentials (encrypted), order history.
                    </li>
                    <li class="list-group-item border-0">
                        <strong>Payment Information:</strong> Processed by secure gateways (we do not store card details).
                    </li>
                    <li class="list-group-item border-0">
                        <strong>Usage Data:</strong> Pages visited, interactions, search activity.
                    </li>
                </ul>

                <!-- Section 2 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-gear-fill me-2"></i>
                    2. How We Use Your Information
                </h4>
                <p>Your information helps us:</p>
                <ul class="list-group mb-3">
                    <li class="list-group-item border-0">Process & deliver your orders.</li>
                    <li class="list-group-item border-0">Send shipment and order updates.</li>
                    <li class="list-group-item border-0">Improve website performance and features.</li>
                    <li class="list-group-item border-0">Provide customer support.</li>
                    <li class="list-group-item border-0">Share promotions (if subscribed).</li>
                </ul>

                <!-- Section 3 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-cookie me-2"></i>
                    3. Cookies & Tracking
                </h4>
                <p>
                    Cookies help us enhance your shopping experience by remembering your cart,
                    preferences, and enabling analytics for continuous improvement.
                </p>

                <!-- Section 4 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-share-fill me-2"></i>
                    4. Sharing Your Information
                </h4>
                <p>We do <strong>not</strong> sell your information. We only share it with:</p>
                <ul class="list-group mb-3">
                    <li class="list-group-item border-0">Payment partners</li>
                    <li class="list-group-item border-0">Shipping/courier providers</li>
                    <li class="list-group-item border-0">Trusted service providers</li>
                </ul>

                <!-- Section 5 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    5. Data Security
                </h4>
                <p>
                    We use industry-standard security practices to protect your personal data
                    from unauthorized access, loss, or misuse.
                </p>

                <!-- Section 6 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-check2-circle me-2"></i>
                    6. Your Rights
                </h4>
                <p>You may request to:</p>
                <ul class="list-group mb-3">
                    <li class="list-group-item border-0">Access your personal data</li>
                    <li class="list-group-item border-0">Update or correct your information</li>
                    <li class="list-group-item border-0">Delete your account</li>
                    <li class="list-group-item border-0">Unsubscribe from marketing emails</li>
                </ul>

                <!-- Section 7 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-people-fill me-2"></i>
                    7. Children’s Privacy
                </h4>
                <p>We do not knowingly collect data from children below 13.</p>

                <!-- Section 8 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    8. Policy Updates
                </h4>
                <p>We may update this policy occasionally. Changes will be posted here.</p>

                <!-- Section 9 -->
                <h4 class="mt-4 text-primary fw-bold">
                    <i class="bi bi-envelope-fill me-2"></i>
                    9. Contact Us
                </h4>
                <p>If you have any questions, reach out to us:</p>
                <div class="bg-light p-3 rounded-3">
                    <p class="fw-semibold mb-1">Books On Door Support</p>
                    <p class="mb-1">Email: <a href="mailto:hemrajlakhara91111@gmail.com">hemrajlakhara91111@gmail.com</a></p>
                    <p class="mb-0">Phone: +91-XXXXXXXXXX</p>
                </div>
            </div>
        </div>
    </div>
</div>
