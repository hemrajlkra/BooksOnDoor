@using System.Text.RegularExpressions
@model ShoppingCart

<form method="post">
    <input asp-for="Id" disabled hidden />

    <div class="card shadow-lg border-0 mt-4 mb-5 rounded-4 overflow-hidden">

        <!-- Product Header -->
        <div class="card-header bg-primary bg-gradient text-light py-4">
            <div class="text-center">
                <h3 class="fw-bold text-white text-uppercase mb-1">
                    @Model.Product.Title
                </h3>
                <p class="text-white-50 mb-0">by @Model.Product.Author</p>
            </div>
        </div>

        <!-- Product Content -->
        <div class="card-body px-4 px-lg-5">
            <a asp-action="Index"
               class="btn btn-outline-secondary bg-gradient fw-semibold btn-sm mb-4">
                ← Back to Home
            </a>

            <div class="row g-4">

                <!-- Product Image -->
                <div class="col-12 col-lg-4 text-center">
                    @if (Model.Product.ProductImages?.Any() == true)
                    {
                        <div id="productCarousel" class="carousel slide rounded shadow-sm">
                            <div class="carousel-inner rounded-3">
                                @foreach (var image in Model.Product.ProductImages.Select((img, idx) => new { img, idx }))
                                {
                                    <div class="carousel-item @(image.idx == 0 ? "active" : "")">
                                        <img src="@image.img.ImageUrl" class="d-block w-100 rounded-3" />
                                    </div>
                                }
                            </div>

                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                    }
                </div>

                <!-- Product Details -->
                <div class="col-12 col-lg-8">

                    <span class="badge bg-secondary mb-2 px-3 py-2">@Model.Product.Category.Name</span>

                    <p class="text-muted mb-1"><strong>ISBN:</strong> @Model.Product.ISBN</p>

                    <p class="text-muted mb-1">
                        <strong>List Price:</strong>
                        <span class="text-decoration-line-through">₹@Model.Product.ListPrice</span>
                    </p>

                    <!-- Price Table -->
                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="row text-center fw-semibold text-secondary small">
                            <div class="col">Quantity</div>
                            <div class="col">1-50</div>
                            <div class="col">51-100</div>
                            <div class="col">100+</div>
                        </div>

                        <div class="row text-center fw-bold mt-2 text-warning">
                            <div class="col">₹@Model.Product.ListPrice</div>
                            <div class="col">₹@Model.Product.Price</div>
                            <div class="col">₹@Model.Product.Price50</div>
                            <div class="col">₹@Model.Product.Price100</div>
                        </div>
                    </div>
                    <p class="text-secondary lh-sm">@Html.Raw(Model.Product.Description)</p>
                    <!-- Quantity -->
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold mb-1">Quantity</label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white border-0 fw-semibold">
                                Count
                            </span>
                            <input asp-for="Count" type="number" value="1" class="form-control text-end" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold text-uppercase rounded-3">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>

    </div>
</form>

<!-- Two-column layout for comments -->
<div class="row g-4">
    <hr class="my-5" />

    <h4 class="fw-bold text-center mb-4">Leave a Comment</h4>
    <!-- Comment Form -->
    <div class="col-md-6 col-lg-7">

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <form asp-action="AddComment" method="post">

                    <input type="hidden" name="ProductId" value="@Model.Product.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" name="UserName" class="form-control rounded-3" placeholder="Your name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment</label>
                        <textarea name="CommentText" rows="3" class="form-control rounded-3" placeholder="Write your comment..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        Submit
                    </button>
                </form>
            </div>
        </div>

    </div>

    <!-- Comment List -->
    <div class="col-md-6 col-lg-5">

        @if (Model.Comments?.Any() == true)
        {
            foreach (var comment in Model.Comments)
            {
                <div class="card mb-3 shadow-sm border-0 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h6 class="fw-bold text-primary m-0">@comment.UserName</h6>
                            <span class="text-muted small">@comment.DatePosted.ToString("dd MMM yyyy hh:mm tt")</span>
                        </div>
                        <p class="mt-2 text-dark">
                            @Html.Raw(Regex.Replace(comment.CommentText, "<.*?>", ""))
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No comments yet. Be the first to comment!</p>
        }

    </div>
</div>
